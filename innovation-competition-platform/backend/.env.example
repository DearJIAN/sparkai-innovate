# Flask 配置
SECRET_KEY=dev-secret-key-change-in-production

# MySQL 数据库配置
DATABASE_URL=mysql+pymysql://root:123456@localhost:3306/innovation_competition?charset=utf8mb4

# JWT 配置
JWT_SECRET_KEY=dev-jwt-secret-key-change-in-production

# 环境
FLASK_ENV=development
FLASK_DEBUG=1

# ============================================
# AI 对话 - 火山方舟
# ============================================
ARK_API_KEY=your_ark_api_key_here
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-1-6-251015
VOICE_TEMPERATURE=0.4

# ============================================
# 实时语音对话 - volc.speech.dialog
# ============================================
VOICE_REALTIME_APP_ID=your_app_id
VOICE_REALTIME_APP_KEY=your_app_key
VOICE_REALTIME_TOKEN=your_token
VOICE_REALTIME_RESOURCE_ID=volc.speech.dialog
VOICE_REALTIME_UID=huahuo-web
VOICE_REALTIME_DIALOG_ADDRESS=wss://openspeech.bytedance.com
VOICE_REALTIME_DIALOG_URI=/api/v3/realtime/dialogue
VOICE_REALTIME_SPEAKER=zh_male_yunzhou_jupiter_bigtts
VOICE_REALTIME_BOT_NAME=火花
VOICE_REALTIME_INPUT_MOD=text

# ============================================
# 语音识别 ASR - /api/asr
# ============================================
ASR_PROVIDER=doubao
DOUBAO_ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel
DOUBAO_ASR_APP_ID=your_app_id
DOUBAO_ASR_ACCESS_TOKEN=your_access_token
DOUBAO_ASR_SECRET_KEY=your_secret_key
DOUBAO_ASR_RESOURCE_ID=volc.bigasr.sauc.duration
DOUBAO_ASR_MODEL_NAME=bigmodel
DOUBAO_ASR_FORMAT=wav
DOUBAO_ASR_RATE=16000
DOUBAO_ASR_BITS=16
DOUBAO_ASR_CHANNEL=1
DOUBAO_ASR_LANGUAGE=zh-CN

# ============================================
# 语音合成 TTS 全局选择
# qianwen：阿里云千问 qwen-tts-realtime
# doubao：豆包语音合成模型 2.0
# aliyun：兼容旧配置，等价于 qianwen
# ============================================
TTS_PROVIDER=qianwen
TTS_FALLBACK_PROVIDER=

# ============================================
# 千问语音合成 TTS
# ============================================
DASHSCOPE_API_KEY=your_dashscope_api_key
ALIYUN_TTS_MODEL=qwen-tts-realtime
ALIYUN_TTS_VOICE=Cherry
ALIYUN_TTS_SAMPLE_RATE=24000
ALIYUN_TTS_MODE=server_commit

# ============================================
# 豆包语音合成模型 2.0
# 双向流式 WebSocket
# ============================================
DOUBAO_TTS_API_KEY=your_doubao_tts_api_key
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
DOUBAO_TTS_SPEAKER=saturn_zh_female_keainvsheng_tob
DOUBAO_TTS_WS_ENDPOINT=wss://openspeech.bytedance.com/api/v3/tts/bidirection
DOUBAO_TTS_FORMAT=pcm
DOUBAO_TTS_SAMPLE_RATE=24000
DOUBAO_TTS_SPEECH_RATE=0
DOUBAO_TTS_LOUDNESS_RATE=0

# ============================================
# AI 智能体 - 通义千问 qwen-mt-flash
# ============================================
GLM_API_KEY=your_glm_api_key
GLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
GLM_MODEL=qwen-plus

# ============================================
# LEGACY：旧版豆包 TTS 配置
# 新豆包 2.0 实现不得读取
# ============================================
DOUBAO_TTS_MODE=v1
DOUBAO_TTS_APP_ID=your_legacy_app_id
DOUBAO_TTS_ACCESS_TOKEN=your_legacy_token
DOUBAO_TTS_SECRET_KEY=your_legacy_secret
DOUBAO_TTS_V1_ENDPOINT=https://openspeech.bytedance.com/api/v1/tts
DOUBAO_TTS_CLUSTER=volcano_tts
DOUBAO_TTS_VOICE_TYPE=zh_female_sajiaonvyou_moon_bigtts
DOUBAO_TTS_ENCODING=mp3
DOUBAO_API_KEY=your_legacy_doubao_api_key
DOUBAO_TTS_UNIDIRECTIONAL_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/unidirectional
DOUBAO_TTS_WS_ENDPOINT_LEGACY=wss://openspeech.bytedance.com/api/v3/tts/unidirectional/stream
DOUBAO_TTS_RESOURCE_ID_LEGACY=seed-tts-1.0
